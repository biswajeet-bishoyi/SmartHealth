# Environment Variables for SmartHealthNE
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real secrets.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/smarthealthne

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend origin (for CORS whitelist)
CLIENT_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

# bcrypt rounds (10 is a good default; increase for production)
BCRYPT_ROUNDS=10
